rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isBandOwner(bandId) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/bands/$(bandId)).data.ownerUid == request.auth.uid;
    }
    function isDeveloper() {
      return request.auth != null && request.auth.token.email == 'kkd00055@gmail.com';
    }
    // 악보 파일(PDF·이미지) — 밴드별 경로. 로그인한 멤버만 읽기.
    // 업로드는 25MB 이하 이미지/PDF 만. 삭제는 로그인 멤버(앱 UI가 올린 사람/관리자로 제한).
    match /bands/{bandId}/scores/{scoreId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null;
    }

    // 개인 기록 폴더의 PDF·이미지. 개인 채널 소유권은 Firestore 문서 규칙에서도 검증한다.
    match /bands/{bandId}/recordFolders/{folderId}/entries/{entryId}/{fileName} {
      allow read: if isDeveloper() || isBandOwner(bandId);
      allow write: if isBandOwner(bandId)
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow delete: if isBandOwner(bandId);
    }

    // (전환기 호환) 기존 전역 악보 경로 — 마이그레이션 전 업로드분 읽기/삭제 유지
    match /scores/{scoreId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null;
    }

    // 버그 제보 첨부 사진 — 로그인한 멤버만. 업로드는 10MB 이하 이미지만.
    match /feedback/{feedbackId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
