rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // 앱 개발자(최상위 권한): 지정 이메일만. 밴드 관리자(admin)와 별개 — 받은 의견 열람 등 개발자 전용.
    function isDeveloper() {
      return signedIn() && request.auth.token.email == 'kkd00055@gmail.com';
    }
    // 관리자 여부: 본인 멤버 문서의 admin 필드가 true (콘솔에서만 부여)
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('admin', false) == true;
    }

    // ── 밴드 스코프 (bands/{bandId}) : 멀티밴드 기반 ──
    // 밴드 멤버 = 그 밴드에 내 멤버 문서가 있는 사람. 밴드 admin = 그 문서의 admin==true.
    function isBandMember(bandId) {
      return signedIn()
        && exists(/databases/$(database)/documents/bands/$(bandId)/members/$(request.auth.uid));
    }
    function isBandAdmin(bandId) {
      return isBandMember(bandId)
        && get(/databases/$(database)/documents/bands/$(bandId)/members/$(request.auth.uid)).data.get('admin', false) == true;
    }
    function isBandOwner(bandId) {
      return signedIn()
        && exists(/databases/$(database)/documents/bands/$(bandId))
        && get(/databases/$(database)/documents/bands/$(bandId)).data.ownerUid == request.auth.uid;
    }

    // 멤버 프로필: 로그인하면 읽기 가능, 본인 문서만 쓰기
    // 단, admin(관리자) 필드는 스스로 켤 수 없음 — 콘솔에서만 부여
    match /members/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.get('admin', false) == false;
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.get('admin', false) == resource.data.get('admin', false);
    }

    // 장소: 로그인한 멤버는 읽기 가능, 추가는 관리자만.
    // 수정·삭제는 멤버 공동 관리 — 주차·현관 비밀번호 등 메모를 다 같이 갱신하기 위함.
    match /places/{placeId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update, delete: if signedIn();
    }

    // 합주 녹음/영상 기록: 로그인하면 읽기·추가 가능, 수정·삭제는 올린 사람 또는 관리자
    match /recordings/{recId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin() || (signedIn() && resource.data.addedBy == request.auth.uid);
    }

    // 악보(파트별 PDF·이미지): 로그인하면 읽기·추가 가능, 수정·삭제는 올린 사람 또는 관리자
    match /scores/{scoreId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin() || (signedIn() && resource.data.addedBy == request.auth.uid);
    }

    // 앱 설정(예: 기록 자동 동기화할 재생목록): 로그인 읽기, 관리자만 쓰기
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 버그 제보·개선 의견: 로그인 멤버는 제출(create)만, 열람·상태변경·삭제는 개발자만
    match /feedback/{fbId} {
      allow read: if isDeveloper();
      allow create: if signedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.status == 'new';
      allow update, delete: if isDeveloper();
    }

    // 사용자 계정 — 내가 속한 밴드(bandId) 등. 본인/개발자만 읽기, 본인만 쓰기.
    // (실제 밴드 가입/이동은 createBand·joinBand 함수가 검증하며 여기 값을 세팅)
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isDeveloper());
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // 초대 코드 → 밴드 매핑. 조회로 코드가 새지 않도록 그 밴드 관리자만 읽기.
    // 발급/회전은 createBand·rotateInviteCode 함수(Admin)만 → 클라 쓰기 금지.
    match /inviteCodes/{code} {
      allow read: if isDeveloper() || isBandAdmin(resource.data.bandId);
      allow write: if false;
    }

    // Android Health Connect 일회용 업로드 토큰. 발급·사용은 Cloud Functions에서만 수행한다.
    match /healthSyncSessions/{sessionId} {
      allow read, write: if false;
    }

    // 음악 재생목록: 로그인한 멤버는 읽기/쓰기 가능 (공동 관리)
    match /playlists/{playlistId} {
      allow read, write: if signedIn();

      // 재생목록 안의 곡
      match /tracks/{trackId} {
        allow read, write: if signedIn();
      }
    }

    // 일정: 로그인한 멤버는 읽기 가능, 생성·수정은 관리자만, 삭제는 관리자 또는 만든 사람
    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);

      // 참석 투표: 로그인하면 읽기 가능, 본인 투표만 쓰기 (문서 id == uid)
      match /attendance/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }

      // 합주곡 셋리스트: 로그인하면 읽기 가능, 추가·삭제는 관리자만
      match /setlist/{songId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    // ─────────────────────────────────────────────────────────────
    // 밴드별 데이터 (bands/{bandId}/...) — 멀티밴드. 위 전역 규칙은 전환기 호환용으로 유지.
    // 읽기/쓰기는 그 밴드 멤버만, 일부는 그 밴드 admin만. (feedback 은 전역·개발자 전용으로 별도)
    // ─────────────────────────────────────────────────────────────
    match /bands/{bandId} {
      // 밴드 멤버, 또는 개발자(전체 밴드 현황 모니터링)
      allow read: if isBandMember(bandId) || isDeveloper();
      // 밴드 생성/멤버십 변경은 createBand·joinBand 함수(Admin)로 처리하므로 클라 직접 생성은 막음
      allow create: if false;
      // 관리자는 밴드 문서 갱신 가능. 일반 멤버는 사용량 계량 필드(storageBytes·aiUsage)만 갱신 허용.
      allow update: if isBandAdmin(bandId)
        || (isBandMember(bandId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['storageBytes', 'aiUsage']));

      match /members/{uid} {
        allow read: if isDeveloper() || isBandMember(bandId);
        // 본인 문서만 생성/수정, admin 은 스스로 켤 수 없음
        allow create: if signedIn() && request.auth.uid == uid
                      && request.resource.data.get('admin', false) == false;
        allow update: if signedIn() && request.auth.uid == uid
                      && request.resource.data.get('admin', false) == resource.data.get('admin', false);
        // 강퇴(밴드 admin) 또는 본인 탈퇴
        allow delete: if isBandAdmin(bandId) || (signedIn() && request.auth.uid == uid);
      }

      match /places/{placeId} {
        allow read: if isDeveloper() || isBandMember(bandId);
        allow create: if isBandAdmin(bandId);
        allow update, delete: if isBandMember(bandId);
      }

      match /recordings/{recId} {
        allow read: if isDeveloper() || isBandMember(bandId);
        allow create: if isBandMember(bandId);
        allow update, delete: if isBandAdmin(bandId) || (isBandMember(bandId) && resource.data.addedBy == request.auth.uid);
      }

      // 밴드 영상 이름 폴더(합주 등). 멤버가 폴더 생성·기록 이관·재생목록 연결을 하므로 멤버 쓰기 허용.
      match /recordingFolders/{folderId} {
        allow read: if isDeveloper() || isBandMember(bandId);
        allow write: if isBandMember(bandId);
      }

      match /scores/{scoreId} {
        allow read: if isDeveloper() || isBandMember(bandId);
        allow create: if isBandMember(bandId);
        allow update, delete: if isBandAdmin(bandId) || (isBandMember(bandId) && resource.data.addedBy == request.auth.uid);
      }

      match /config/{docId} {
        allow read: if isDeveloper() || isBandMember(bandId);
        allow write: if isBandAdmin(bandId);
      }

      match /playlists/{playlistId} {
        allow read: if isDeveloper() || isBandMember(bandId);
        allow write: if isBandMember(bandId);
        match /tracks/{trackId} {
          allow read: if isDeveloper() || isBandMember(bandId);
          allow write: if isBandMember(bandId);
        }
      }

      // 개인 템플릿 영상 라이브러리: 폴더와 하위 유튜브 링크
      match /videoFolders/{folderId} {
        allow read: if isDeveloper() || isBandOwner(bandId);
        allow write: if isBandOwner(bandId);
        match /videos/{videoId} {
          allow read: if isDeveloper() || isBandOwner(bandId);
          allow write: if isBandOwner(bandId);
        }
        match /ingredients/{ingredientId} {
          allow read: if isDeveloper() || isBandOwner(bandId);
          allow write: if isBandOwner(bandId);
        }
      }

      // 개인 템플릿 기록 모듈: 이후 폴더 하위 기록 형식을 확장한다.
      match /recordFolders/{folderId} {
        allow read: if isDeveloper() || isBandOwner(bandId);
        allow write: if isBandOwner(bandId);
        match /entries/{entryId} {
          allow read: if isDeveloper() || isBandOwner(bandId);
          allow write: if isBandOwner(bandId);
        }
      }

      match /events/{eventId} {
        allow read: if isDeveloper() || isBandMember(bandId);
        allow create, update: if isBandAdmin(bandId);
        allow delete: if isBandAdmin(bandId) || (isBandMember(bandId) && resource.data.createdBy == request.auth.uid);

        match /attendance/{uid} {
          allow read: if isDeveloper() || isBandMember(bandId);
          allow write: if isBandMember(bandId) && request.auth.uid == uid;
        }
        match /setlist/{songId} {
          allow read: if isDeveloper() || isBandMember(bandId);
          allow write: if isBandAdmin(bandId);
        }
      }
    }
  }
}
