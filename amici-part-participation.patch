+/* ---------------- 셋리스트 (events/{eventId}/setlist/{songId}) ---------------- */
+export function watchSetlist(
+  eventId: string,
+  cb: (songs: SetlistSong[]) => void,
+  onError?: (e: Error) => void,
+): () => void {
+  if (DEMO) return demoDb.watchSetlist(eventId, cb)
+  return onSnapshot(
+    collection(db, 'events', eventId, 'setlist'),
+    (snap) => {
+      const list = snap.docs.map((d) => ({ id: d.id, ...(d.data() as Omit<SetlistSong, 'id'>) }))
+      list.sort((a, b) => (a.order ?? a.addedAt) - (b.order ?? b.addedAt))
+      cb(list)
+    },
+    (err) => {
+      console.error('watchSetlist', err)
+      onError?.(err)
+    },
+  )
+}
+
+/** 셋리스트에 곡 추가 (관리자). songId = trackId 로 중복 방지 */
+export async function addSetlistSong(eventId: string, song: SetlistSong): Promise<void> {
+  if (DEMO) return demoDb.addSetlistSong(eventId, song)
+  const { id, ...rest } = song
+  const data = Object.fromEntries(Object.entries(rest).filter(([, v]) => v !== undefined))
+  await setDoc(doc(db, 'events', eventId, 'setlist', id), data)
+}
+
+/** 셋리스트에서 곡 제거 (관리자) */
+export async function removeSetlistSong(eventId: string, songId: string): Promise<void> {
+  if (DEMO) return demoDb.removeSetlistSong(eventId, songId)
+  await deleteDoc(doc(db, 'events', eventId, 'setlist', songId))
+}
+
+/** 곡 선택기·참여 요약용: 모든 재생목록의 곡을 한 번에 로드 */
+export async function getAllPlaylistTracks(): Promise<
+  Array<{ playlistId: string; playlistName: string; track: Track }>
+> {
+  if (DEMO) return demoDb.getAllPlaylistTracks()
+  const out: Array<{ playlistId: string; playlistName: string; track: Track }> = []
+  const plSnap = await getDocs(collection(db, 'playlists'))
+  for (const pl of plSnap.docs) {
+    const playlistName = (pl.data() as Playlist).name ?? ''
+    const trSnap = await getDocs(collection(db, 'playlists', pl.id, 'tracks'))
+    for (const tr of trSnap.docs) {
+      out.push({ playlistId: pl.id, playlistName, track: { id: tr.id, ...(tr.data() as Omit<Track, 'id'>) } })
+    }
+  }
+  return out
+}
