+/** 곡 참여자 → 파트별 인원 요약 */
+function partSummary(track: Track | undefined) {
+  const parts = track?.participants ?? {}
+  const uids = Object.keys(parts)
+  const fixed = PART_ORDER.map((p) => ({
+    label: PART_META[p].label,
+    n: uids.filter((u) => parts[u] === p).length,
+  })).filter((g) => g.n > 0)
+  const customLabels: string[] = []
+  uids.forEach((u) => {
+    const v = parts[u]
+    if (!isFixedPart(v) && !customLabels.includes(v)) customLabels.push(v)
+  })
+  const custom = customLabels.map((label) => ({
+    label,
+    n: uids.filter((u) => parts[u] === label).length,
+  }))
+  return { count: uids.length, groups: [...fixed, ...custom] }
+}
